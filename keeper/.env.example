# Railway variables — never commit real secrets.

ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
KEEPER_KEY=

# Fill after deploy
DEV_MSFT_ROUTER=
MSFT_HOLDER_DISTRIBUTOR=

# DEVS / MSFT on Robinhood Chain (defaults baked into keeper)
DEV_TOKEN=0x80Db362eAB104Ec378E19D0a3dCD5E84Bafd4bA3
MSFT_TOKEN=0xe93237C50D904957Cf27E7B1133b510C669c2e74

# Pool LP address(es) to exclude from MSFT holder payouts (comma-separated).
POOL=0x8366a39cc670b4001a1121b8f6a443a643e40951
# POOLS=0x...,0x...
EXCLUDE=

# Holder snapshot source: robinscan (default) | blockscout | rpc
HOLDERS_SOURCE=robinscan
# ROBINSCAN_URL=https://robinscan.io
REQUIRE_ROBINSCAN=1
# Cached JSON on Railway volume (refreshed every cron run)
# HOLDERS_CACHE_PATH=/data/holders-robinscan.json

# Blockscout (optional fallback / legacy)
# BLOCKSCOUT_API_KEY=proapi_...
# BLOCKSCOUT_CHAIN_ID=4663
# REQUIRE_BLOCKSCOUT=0

# Refuse lockRound if fewer than this many eligible holders (catches partial snapshots):
MIN_ELIGIBLE_HOLDERS=380
# OLD distributor on Robinhood needs L1 checkpoint for openRound:
OPEN_CHECKPOINT=25866117
DISTRIBUTOR_USE_L1_CHECKPOINT=1

# Pro-rata test: ALLOCATION_MODE=pro_rata (default equal)
# ALLOCATION_MODE=equal

PAY_BATCH_SIZE=40
# DRY_RUN=true
