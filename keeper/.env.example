# Railway variables — never commit real secrets.

ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
KEEPER_KEY=

# --- Multi-tenant (Project B) ---
# SERVICE=keeper|api          (Dockerfile)
# DRIP_MODE=all               # loop registry; "single" = legacy one-flywheel env
# DRIP_REGISTRY_PATH=/data/drips.json
# PLATFORM_FEE_BPS=1000
# TREASURY=0x374d91a5674fa7cf86e725093b5848b97e1e13b4
# DRIP_FACTORY=               # after DeployDripFactory
# INCLUDE_MANUAL=0            # 1 = also run non-automated test drips
# DRIP_ID=                    # run one registry drip

# --- Legacy single flywheel (bits / DEVS) ---
DEV_MSFT_ROUTER=
MSFT_HOLDER_DISTRIBUTOR=
DEV_TOKEN=0x80Db362eAB104Ec378E19D0a3dCD5E84Bafd4bA3
MSFT_TOKEN=0xe93237C50D904957Cf27E7B1133b510C669c2e74

# Pool LP address(es) to exclude from holder payouts (comma-separated).
POOL=
EXCLUDE=

HOLDERS_SOURCE=robinscan
REQUIRE_ROBINSCAN=1
HOLDERS_CACHE_PATH=/data/holders.csv
ROUNDS_CACHE_DIR=/data/rounds

MIN_ELIGIBLE_HOLDERS=1
ALLOCATION_MODE=pro_rata
PAY_BATCH_SIZE=40

# Stuck locked round without merkle on volume:
# SKIP_ROUND_IDS=1

# MIN_PAYOUT_WEI=1000000000000
# DRY_RUN=true
