# Railway variables — never commit real secrets.

ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
KEEPER_KEY=

# Fill after deploy
DEV_MSFT_ROUTER=
MSFT_HOLDER_DISTRIBUTOR=

# DEVS / MSFT on Robinhood Chain (defaults baked into keeper)
DEV_TOKEN=0x80Db362eAB104Ec378E19D0a3dCD5E84Bafd4bA3
MSFT_TOKEN=0xe93237C50D904957Cf27E7B1133b510C669c2e74

# Pool LP address(es) to exclude from MSFT holder payouts (comma-separated).
POOL=0x8366a39cc670b4001a1121b8f6a443a643e40951
# POOLS=0x...,0x...
EXCLUDE=

# Holder snapshot — Blockscout PRO API (required for auto-refresh each cron run)
# Free key: https://dev.blockscout.com
BLOCKSCOUT_API_KEY=proapi_...
BLOCKSCOUT_CHAIN_ID=4663
# BLOCKSCOUT_PRO_API_URL=https://api.blockscout.com
# BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com
# Auto-downloaded fresh CSV each run (default: keeper/.cache/holders-<token>.csv)
# HOLDERS_CACHE_PATH=/data/holders.csv
# Manual override — skips auto-download:
# HOLDERS_CSV_PATH=/path/to/holders.csv
# Fail if Blockscout unavailable (default on when BLOCKSCOUT_API_KEY is set):
REQUIRE_BLOCKSCOUT=1
# Refuse lockRound if fewer than this many eligible holders (catches RPC fallback):
MIN_ELIGIBLE_HOLDERS=400
# OLD distributor on Robinhood needs L1 checkpoint for openRound:
OPEN_CHECKPOINT=25866117
DISTRIBUTOR_USE_L1_CHECKPOINT=1
# Fallback CSV URL if needed:
# HOLDERS_CSV_URL=https://...
# HOLDERS_SOURCE=rpc

PAY_BATCH_SIZE=40
# equal (default) | pro_rata — pro-rata weights MSFT by DEVS balance; smallest holders may get 0 wei
# ALLOCATION_MODE=equal
# DRY_RUN=true
