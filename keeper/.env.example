# Railway variables — never commit real secrets.

ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
KEEPER_KEY=

# Fill after deploy
DEV_MSFT_ROUTER=
MSFT_HOLDER_DISTRIBUTOR=

# DEVS / MSFT on Robinhood Chain (defaults baked into keeper)
DEV_TOKEN=0x80Db362eAB104Ec378E19D0a3dCD5E84Bafd4bA3
MSFT_TOKEN=0xe93237C50D904957Cf27E7B1133b510C669c2e74

# Pool LP address(es) to exclude from MSFT holder payouts (comma-separated).
POOL=0x8366a39cc670b4001a1121b8f6a443a643e40951
EXCLUDE=

# Holder snapshot — Robinscan only (default). Fresh fetch every cron run.
HOLDERS_SOURCE=robinscan
REQUIRE_ROBINSCAN=1
# ROBINSCAN_URL=https://robinscan.io
# Cached CSV on Railway volume (Blockscout-compatible HolderAddress,Balance format):
HOLDERS_CACHE_PATH=/data/holders.csv

# Blockscout is disabled unless you explicitly set HOLDERS_SOURCE=blockscout
# HOLDERS_SOURCE=blockscout
# BLOCKSCOUT_API_KEY=proapi_...

MIN_ELIGIBLE_HOLDERS=380
OPEN_CHECKPOINT=25866117
DISTRIBUTOR_USE_L1_CHECKPOINT=1

# Pro-rata by DEVS balance (default). Set ALLOCATION_MODE=equal for one-share-per-wallet.
ALLOCATION_MODE=pro_rata

PAY_BATCH_SIZE=40
# Comma-separated round IDs to ignore (e.g. stuck locked round with lost merkle snapshot).
# SKIP_ROUND_IDS=11
# How many recent rounds to scan for resume (default 4 — avoids RPC rate limits).
# ACTIVE_ROUND_LOOKBACK=4
# DRY_RUN=true
